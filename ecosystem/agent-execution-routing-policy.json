{
  "schema_version": 1,
  "execution_targets": [
    "github_actions",
    "isolated_workspace",
    "host_exception"
  ],
  "runner_classes": [
    "github_hosted",
    "organization_product_isolated",
    "isolated_workspace",
    "not_applicable"
  ],
  "target_runner_compatibility": {
    "github_actions": [
      "github_hosted",
      "organization_product_isolated"
    ],
    "isolated_workspace": [
      "isolated_workspace"
    ],
    "host_exception": [
      "not_applicable"
    ]
  },
  "preflight_freshness": {
    "max_age_seconds": 900
  },
  "remote_desktop_reasons": [
    "host_only_service",
    "lan_or_hardware",
    "self_hosted_runner_diagnosis"
  ],
  "resume_preflight_required_fields": [
    "verified_at",
    "repository",
    "default_branch_sha",
    "governing_issue",
    "pull_request",
    "task_head_sha"
  ],
  "forbidden_remote_desktop_actions_when_equivalent_ci": [
    "poll_process_output",
    "poll_docker_logs",
    "poll_workflow_state",
    "poll_git_state"
  ],
  "parallel_lane_rules": {
    "strategies": [
      "parallel_first",
      "serial_with_reason"
    ],
    "required_lane_fields": [
      "id",
      "owned_paths",
      "depends_on",
      "branch_and_worktree",
      "shared_leases"
    ],
    "one_writer_per_lane": true,
    "overlap_requires_lease": true,
    "constrained_resource_requires_lease": true,
    "serial_requires_reason": true,
    "integration_order_required": true
  }
}
