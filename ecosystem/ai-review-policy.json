{
  "schema_version": 1,
  "policy_id": "oteryn-ai-review-risk-v1",
  "lifecycle_authority": "Oteryn/Oteryn#12",
  "bootstrap_exception_issue": 12,
  "review_tiers": {
    "R0": {
      "external_review": "none",
      "reviewer_class": null
    },
    "R1": {
      "external_review": "required",
      "reviewer_class": "fast"
    },
    "R2": {
      "external_review": "required",
      "reviewer_class": "deep"
    }
  },
  "reviewer_preferences": {
    "fast": [
      "codex_spark",
      "codex"
    ],
    "deep": [
      "codex"
    ]
  },
  "activation": {
    "draft_must_be_false": true,
    "required_ci_must_be_green": true,
    "review_only_stable_fingerprint": true,
    "max_primary_invocations_per_fingerprint": 1,
    "quota_unavailable_result": "WAITING_REVIEW_QUOTA"
  },
  "review_neutral_globs": [
    "docs/evidence/**",
    "docs/agents/tasks/archive/**",
    "docs/generated/**",
    "artifacts/checksums/**"
  ],
  "standalone_r0_globs": [
    "docs/evidence/**",
    "docs/agents/tasks/archive/**",
    "docs/generated/**",
    "artifacts/checksums/**"
  ],
  "always_r2_globs": [
    "AGENTS.md",
    "**/AGENTS.md",
    "**/AGENTS.override.md",
    "SECURITY.md",
    ".github/CODEOWNERS",
    ".github/workflows/**",
    "docs/architecture/adr/**",
    "docs/contracts/**",
    "docs/operations/**",
    "docs/recovery/**",
    "docs/agents/prompts/**",
    "ecosystem/ai-review-policy.json",
    "tools/governance/ai_review_policy.py",
    "**/migrations/**",
    "**/migration/**",
    "**/deploy/**",
    "**/deployment/**",
    "**/security/**",
    "**/auth/**",
    "docs/architecture/**",
    "docs/agents/tasks/active/**"
  ],
  "r1_code_extensions": [
    ".c",
    ".cc",
    ".cpp",
    ".go",
    ".js",
    ".jsx",
    ".php",
    ".py",
    ".rs",
    ".sh",
    ".sql",
    ".ts",
    ".tsx"
  ],
  "size_thresholds": {
    "r1_changed_lines": 250,
    "r2_changed_lines": 800
  },
  "special_r0_rules": {
    "immutable_action_pin_only": true,
    "exact_incorporated_branch_delete": true,
    "immutable_action_pin_same_major_only": true,
    "lifecycle_metadata_only": true,
    "composer_dev_patch_only": true
  },
  "review_reuse": {
    "reviewed_head_must_be_ancestor": true,
    "same_tier_required": true,
    "same_fingerprint_required": true,
    "post_review_changes_must_be_review_neutral": true,
    "final_required_ci_must_be_green": true,
    "unrelated_base_advance_preserves_fingerprint": true,
    "risk_bearing_base_blob_change_invalidates_fingerprint": true,
    "rebased_head_requires_ancestor_rule": true
  },
  "r2_changed_line_markers": [
    "authorization",
    "authentication",
    "permission",
    "secret",
    "credential",
    "token",
    "cryptograph",
    "branch protection",
    "ruleset",
    "required check",
    "production",
    "deploy",
    "rollback",
    "restore",
    "migration",
    "delete",
    "cross-repository",
    "cross repository",
    "entitlement",
    "payment"
  ],
  "r1_dependency_globs": [
    "composer.json",
    "composer.lock",
    "package.json",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "Cargo.toml",
    "Cargo.lock",
    "go.mod",
    "go.sum",
    "requirements*.txt",
    "pyproject.toml",
    "poetry.lock",
    "uv.lock"
  ],
  "r0_prose_extensions": [
    ".md",
    ".txt",
    ".rst",
    ".adoc"
  ],
  "r2_sensitive_dependency_markers": [
    "google2fa",
    "totp",
    "oauth",
    "openid",
    "jwt",
    "jsonwebtoken",
    "cryptography",
    "libsodium",
    "argon2",
    "bcrypt",
    "password-hash",
    "stripe",
    "payment"
  ],
  "r1_config_extensions": [
    ".ps1",
    ".bat",
    ".cmd",
    ".lua",
    ".toml",
    ".ini",
    ".cfg",
    ".conf",
    ".env",
    ".yaml",
    ".yml"
  ],
  "r1_executable_filenames": [
    "Dockerfile",
    "Makefile",
    "CMakeLists.txt",
    "Justfile",
    "Taskfile",
    "Procfile"
  ],
  "reviewer_source_logins": {
    "codex": [
      "chatgpt-codex-connector[bot]"
    ],
    "codex_spark": [
      "chatgpt-codex-connector[bot]"
    ]
  },
  "reviewer_source_kinds": {
    "codex": [
      "pull_request_review",
      "issue_comment"
    ],
    "codex_spark": [
      "pull_request_review",
      "issue_comment"
    ]
  }
}
