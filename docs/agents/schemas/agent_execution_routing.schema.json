{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Oteryn/Oteryn/blob/main/docs/agents/schemas/agent_execution_routing.schema.json",
  "title": "Oteryn agent execution routing policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_targets",
    "runner_classes",
    "remote_desktop_reasons",
    "resume_preflight_required_fields",
    "parallel_lane_rules",
    "forbidden_remote_desktop_actions_when_equivalent_ci"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "execution_targets": {
      "type": "array",
      "items": {"enum": ["github_actions", "isolated_workspace", "host_exception"]},
      "uniqueItems": true,
      "minItems": 3
    },
    "runner_classes": {
      "type": "array",
      "items": {"enum": ["github_hosted", "organization_product_isolated", "isolated_workspace", "not_applicable"]},
      "uniqueItems": true,
      "minItems": 4
    },
    "remote_desktop_reasons": {
      "type": "array",
      "items": {"enum": ["host_only_service", "lan_or_hardware", "self_hosted_runner_diagnosis"]},
      "uniqueItems": true,
      "minItems": 3
    },
    "resume_preflight_required_fields": {
      "type": "array",
      "items": {"enum": ["verified_at", "repository", "default_branch_sha", "governing_issue", "pull_request", "task_head_sha"]},
      "uniqueItems": true,
      "minItems": 6,
      "maxItems": 6
    },
    "forbidden_remote_desktop_actions_when_equivalent_ci": {
      "type": "array",
      "items": {"enum": ["poll_process_output", "poll_docker_logs", "poll_workflow_state", "poll_git_state"]},
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 4
    },
    "parallel_lane_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategies", "required_lane_fields", "one_writer_per_lane", "overlap_requires_lease", "constrained_resource_requires_lease", "serial_requires_reason", "integration_order_required"],
      "properties": {
        "strategies": {"type": "array", "items": {"enum": ["parallel_first", "serial_with_reason"]}, "uniqueItems": true, "minItems": 2, "maxItems": 2},
        "required_lane_fields": {"type": "array", "items": {"enum": ["id", "owned_paths", "depends_on", "branch_and_worktree", "shared_leases"]}, "uniqueItems": true, "minItems": 5, "maxItems": 5},
        "one_writer_per_lane": {"const": true},
        "overlap_requires_lease": {"const": true},
        "constrained_resource_requires_lease": {"const": true},
        "serial_requires_reason": {"const": true},
        "integration_order_required": {"const": true}
      }
    }
  }
}
